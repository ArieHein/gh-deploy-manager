<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - gh_deploy_manager</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/gh_deploy_manager.styles.css" asp-append-version="true" />
</head>
<body>
    <header class="top-shell border-bottom">
        <nav class="navbar navbar-expand-sm navbar-dark bg-dark">
            <div class="container-fluid px-4">
                <a class="navbar-brand fw-semibold" asp-area="" asp-page="/Index">Deploy Manager</a>
                <div class="d-flex align-items-center gap-2">
                    @if (User.Identity?.IsAuthenticated ?? false)
                    {
                        <span class="navbar-text small navbar-user-label me-2">@User.Identity?.Name</span>
                        <form method="post" asp-page="/Logout">
                            <button class="btn btn-outline-light btn-sm" type="submit">Sign out</button>
                        </form>
                    }
                    else
                    {
                        <a class="btn btn-outline-light btn-sm" asp-page="/Login">Sign in</a>
                    }
                </div>
            </div>
        </nav>
    </header>
    <div class="container-fluid px-4 py-3">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted bg-white">
        <div class="container-fluid px-4">
            &copy; 2026 - Deploy Manager Concept
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>